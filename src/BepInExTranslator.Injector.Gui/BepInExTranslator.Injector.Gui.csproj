<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BepInExTranslator.Injector.Gui</RootNamespace>
    <AssemblyName>BepInExTranslator.Injector.Gui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>BepInEx Translator Injector</ApplicationTitle>
    <!-- Windows 桌面产物；仍可在 Linux CI 上 restore/build（无头）。 -->
    <Description>Windows standalone GUI injector for BepInEx + Translator (REQUIREMENTS §7).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BepInExTranslator.Injector.Core\BepInExTranslator.Injector.Core.csproj" />
  </ItemGroup>
</Project>
